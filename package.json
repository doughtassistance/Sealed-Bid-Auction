{
  "name": "midnight-sealed-bid-auction",
  "version": "1.0.0",
  "description": "Sealed-Bid Auction dApp on Midnight Network — private bids, verifiable winner using zero-knowledge proofs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "compile": "compact compile contracts/auction.compact --output managed/",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "tsx scripts/deploy.ts",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "midnight",
    "zk",
    "privacy",
    "sealed-bid",
    "auction",
    "zero-knowledge"
  ],
  "author": "pramo",
  "license": "MIT",
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "^0.19.0",
    "@midnight-ntwrk/dapp-connector-api": "^4.0.1",
    "@midnight-ntwrk/midnight-js-contracts": "^4.1.1",
    "@midnight-ntwrk/midnight-js-network-provider": "file:packages/midnight-js-network-provider",
    "@midnight-ntwrk/midnight-js-types": "^4.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^24.1.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^2.0.5"
  }
}
