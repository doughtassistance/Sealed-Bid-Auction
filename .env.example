# Midnight Network Configuration
# Copy this file to .env and fill in your values

# Network: preprod | preview | local
VITE_MIDNIGHT_NETWORK=preprod

# Midnight Preprod Indexer URL
VITE_MIDNIGHT_INDEXER_URL=https://indexer.preprod.midnight.network

# Midnight Preprod RPC Node URL
VITE_MIDNIGHT_NODE_URL=https://rpc.preprod.midnight.network

# Local Proof Server URL (Docker: docker run -p 6300:6300 midnightnetwork/proof-server)
VITE_MIDNIGHT_PROOF_SERVER_URL=http://localhost:6300

# Deployed Contract Address (paste after deploying to Preprod)
VITE_CONTRACT_ADDRESS=0x_PASTE_YOUR_CONTRACT_ADDRESS_HERE
